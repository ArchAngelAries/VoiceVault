  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/ArchAngelAries/VoiceVault",
  "repository": { "type": "git", "url": "https://github.com/ArchAngelAries/VoiceVault.git" },
  "bugs": { "url": "https://github.com/ArchAngelAries/VoiceVault/issues" },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron electron/main.cjs",
    "electron:build": "vite build && node electron/stage-resources.cjs && electron-builder --win dir --x64 --config electron/electron-builder.cjs",
    "dist:win": "vite build && node electron/stage-resources.cjs && electron-builder --win nsis --x64 --config electron/electron-builder.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "axios": "^1.7.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "tailwind-merge": "^2.3.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
